{
  "Date": {
    "prefix": "date",
    "body": ["${CURRENT_DATE}/${CURRENT_MONTH}/${CURRENT_YEAR}"],
    "description": "Current Date"
  },
  "Date&Time": {
    "prefix": "datetime",
    "body": [
      "${CURRENT_DATE} ${CURRENT_MONTH_NAME_SHORT} ${CURRENT_YEAR}, ${CURRENT_HOUR}:${CURRENT_MINUTE}"
    ],
    "description": "Date and Time stamp"
  },
  "Date&TimeFormat": {
    "prefix": "datetimef",
    "body": [
      "${CURRENT_DATE}/${CURRENT_MONTH}/${CURRENT_YEAR} - ${CURRENT_HOUR}:${CURRENT_MINUTE}"
    ],
    "description": "Date and Time stamp"
  },
  "TimestampFormat": {
    "prefix": "timestamp",
    "body": [
      "${CURRENT_YEAR}${CURRENT_MONTH}${CURRENT_DATE}${CURRENT_HOUR}${CURRENT_MINUTE}${CURRENT_SECOND}"
    ],
    "description": "Timestamp yyyymmddhh24miss"
  },
  "Time": {
    "prefix": "time",
    "body": ["${CURRENT_HOUR}:${CURRENT_MINUTE}"],
    "description": "Timestamp"
  }
}
